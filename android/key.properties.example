# Release Keystore Configuration Example
# 
# To create a release keystore, run:
#   keytool -genkey -v -keystore android/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Then copy this file to android/key.properties and replace the values below:
# (Note: android/key.properties is git-ignored and should never be committed)
#
storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=upload
storeFile=upload-keystore.jks
